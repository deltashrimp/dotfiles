// ============================================================
// Calm — animation preset
//
// M3 slow motion tokens with critically damped springs:
//   - damping-ratio=1.0 everywhere: no bounce, no overshoot
//   - low stiffness: relaxed, unhurried settling
//   - longer durations (medium1–medium3) for easing animations
// ============================================================
animations {
    workspace-switch {
        // Critically damped, slow: settles cleanly without any bounce
        spring damping-ratio=1.0 stiffness=300 epsilon=0.0001
    }

    window-open {
        duration-ms 300 // medium2
        // Standard decelerate: cubic-bezier(0, 0, 0, 1)
        curve "cubic-bezier" 0 0 0 1
    }

    window-close {
        duration-ms 250 // medium1
        // Standard accelerate: cubic-bezier(0.3, 0, 1, 1)
        curve "cubic-bezier" 0.3 0 1 1
    }

    // The three below should stay identical: niri synchronizes
    // these animations with each other during resizes.
    horizontal-view-movement {
        // Slow, critically damped: glides to a stop, never oscillates
        spring damping-ratio=1.0 stiffness=200 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=200 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=200 epsilon=0.0001
    }

    config-notification-open-close {
        // M3 slow effects spring: gentle fade, no bounce
        spring damping-ratio=1.0 stiffness=800 epsilon=0.001
    }

    exit-confirmation-open-close {
        spring damping-ratio=1.0 stiffness=300 epsilon=0.01
    }

    screenshot-ui-open {
        duration-ms 350 // medium3
        curve "cubic-bezier" 0 0 0 1 // standard decelerate
    }

    overview-open-close {
        spring damping-ratio=1.0 stiffness=250 epsilon=0.0001
    }

    recent-windows-close {
        spring damping-ratio=1.0 stiffness=400 epsilon=0.001
    }
}
