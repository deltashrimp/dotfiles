// ============================================================
// Material 3 Standard (default) — animation preset
//
// Based on Google's M3 Standard motion tokens:
//   - Spatial springs: damping-ratio=0.9 (barely any bounce)
//       default spatial: stiffness=700
//   - Effects springs: critically damped (damping-ratio=1.0)
//   - Easing uses the "standard" curves with short durations
// ============================================================
animations {
    workspace-switch {
        // Standard default spatial spring: smooth, almost no bounce
        spring damping-ratio=0.9 stiffness=700 epsilon=0.0001
    }

    window-open {
        duration-ms 200 // short4
        // Standard decelerate: cubic-bezier(0, 0, 0, 1)
        curve "cubic-bezier" 0 0 0 1
    }

    window-close {
        duration-ms 150 // short3
        // Standard accelerate: cubic-bezier(0.3, 0, 1, 1)
        curve "cubic-bezier" 0.3 0 1 1
    }

    // The three below should stay identical: niri synchronizes
    // these animations with each other during resizes.
    horizontal-view-movement {
        spring damping-ratio=0.9 stiffness=700 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=0.9 stiffness=700 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=0.9 stiffness=700 epsilon=0.0001
    }

    config-notification-open-close {
        // Standard default effects spring: clean, no bounce
        spring damping-ratio=1.0 stiffness=1600 epsilon=0.001
    }

    exit-confirmation-open-close {
        spring damping-ratio=0.9 stiffness=700 epsilon=0.01
    }

    screenshot-ui-open {
        duration-ms 200 // short4
        curve "cubic-bezier" 0 0 0 1 // standard decelerate
    }

    overview-open-close {
        spring damping-ratio=0.9 stiffness=700 epsilon=0.0001
    }

    recent-windows-close {
        // M3 slow effects spring (same as the niri default)
        spring damping-ratio=1.0 stiffness=800 epsilon=0.001
    }
}
