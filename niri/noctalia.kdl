layout {

    focus-ring {
        active-color   "#1a7f67"
        inactive-color "#081512"
        urgent-color   "#933636"
    }

    border {
        active-color   "#1a7f67"
        inactive-color "#081512"
        urgent-color   "#933636"
    }


    tab-indicator {
        active-color   "#1a7f67"
        inactive-color "#0b4135"
        urgent-color   "#933636"
    }

    insert-hint {
        color "#1a7f6780"
    }
}

recent-windows {
    highlight {
        active-color "#1a7f67"
        urgent-color "#933636"
    }
}
