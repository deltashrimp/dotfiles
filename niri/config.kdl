// Check the wiki for a full description of the configuration:
// https://niri-wm.github.io/niri/Configuration:-Introduction

spawn-at-startup "noctalia"

// spawn-at-startup "waypaper" "--restore"

/-layer-rule {
    match namespace="^mpvpaper$"
    place-within-backdrop true
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot %H-%M %d-%m-%Y.png"


include "cfg/input.kdl"
include "cfg/monitors.kdl"
include "cfg/window-rules.kdl"
include "cfg/layout.kdl"
include "cfg/misc.kdl"
include "cfg/keybinds.kdl"

// Animation preset (Material 3): uncomment exactly one of the lines below.
include "cfg/animations-expressive.kdl"
// include "cfg/animations-default.kdl"
// include "cfg/animations-calm.kdl"

include "noctalia.kdl"
